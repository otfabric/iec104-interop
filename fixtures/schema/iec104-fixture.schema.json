{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec104-interop/fixtures/schema/iec104-fixture.schema.json",
  "title": "iec104-interop fixture",
  "description": "A simulated IEC 60870-5-104 controlled station: its points, their initial values and the commands that act on them. See docs/FIXTURES.md for the behaviour every server adapter derives from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "station", "points"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonAddress"],
      "properties": {
        "commonAddress": { "type": "integer", "minimum": 1, "maximum": 65534 }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/point" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "ioa": { "type": "integer", "minimum": 1, "maximum": 16777215 },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ioa", "type", "value"],
      "properties": {
        "ioa": { "$ref": "#/$defs/ioa" },
        "type": {
          "enum": ["M_SP_NA_1", "M_DP_NA_1", "M_ST_NA_1", "M_BO_NA_1", "M_ME_NA_1", "M_ME_NB_1", "M_ME_NC_1", "M_IT_NA_1"]
        },
        "value": { "type": ["boolean", "number"] },
        "transient": { "type": "boolean" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 31 },
        "quality": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["OV", "BL", "SB", "NT", "IV", "CY", "CA"] }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "M_SP_NA_1" } } },
          "then": { "properties": { "value": { "type": "boolean" }, "quality": { "items": { "enum": ["BL", "SB", "NT", "IV"] } } } } },
        { "if": { "properties": { "type": { "const": "M_DP_NA_1" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 3 }, "quality": { "items": { "enum": ["BL", "SB", "NT", "IV"] } } } } },
        { "if": { "properties": { "type": { "const": "M_ST_NA_1" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": -64, "maximum": 63 }, "quality": { "items": { "enum": ["OV", "BL", "SB", "NT", "IV"] } } } } },
        { "if": { "properties": { "type": { "const": "M_BO_NA_1" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "quality": { "maxItems": 0 } } } },
        { "if": { "properties": { "type": { "enum": ["M_ME_NA_1", "M_ME_NB_1"] } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": -32768, "maximum": 32767 }, "quality": { "items": { "enum": ["OV", "BL", "SB", "NT", "IV"] } } } } },
        { "if": { "properties": { "type": { "const": "M_ME_NC_1" } } },
          "then": { "properties": { "value": { "type": "number" }, "quality": { "items": { "enum": ["OV", "BL", "SB", "NT", "IV"] } } } } },
        { "if": { "properties": { "type": { "const": "M_IT_NA_1" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }, "quality": { "items": { "enum": ["CY", "CA", "IV"] } } } } },
        { "if": { "not": { "properties": { "type": { "const": "M_ST_NA_1" } } } },
          "then": { "not": { "required": ["transient"] } } },
        { "if": { "not": { "properties": { "type": { "const": "M_IT_NA_1" } } } },
          "then": { "not": { "required": ["sequence"] } } }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ioa", "type", "target"],
      "properties": {
        "ioa": { "$ref": "#/$defs/ioa" },
        "type": { "enum": ["C_SC_NA_1", "C_DC_NA_1", "C_RC_NA_1", "C_SE_NA_1", "C_SE_NB_1", "C_SE_NC_1"] },
        "target": { "$ref": "#/$defs/ioa" },
        "reportCause": { "enum": [3, 11] },
        "selectRequired": { "type": "boolean" }
      }
    }
  }
}
