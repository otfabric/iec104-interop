{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec104-interop/schemas/client-result.schema.json",
  "title": "iec104-interop client result document",
  "description": "The single line a 'client' operation prints. See docs/CONTAINER_CONTRACT.md.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "operation", "ok", "error", "connected", "startdtConfirmed",
               "confirmations", "terminated", "asdus", "elapsedMs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string" },
    "operation": {
      "enum": ["connect", "interrogate", "counter-interrogate", "read", "clock-sync", "test-command", "command",
               "monitor"]
    },
    "ok": { "type": "boolean" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": ["connect-failed", "startdt-timeout", "stopdt-timeout", "timeout", "negative-confirmation",
                       "connection-lost", "failed"]
            },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "connected": { "type": "boolean" },
    "startdtConfirmed": { "type": "boolean" },
    "stopdtConfirmed": { "type": "boolean" },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cot", "negative"],
        "properties": {
          "cot": { "enum": [7, 9, 44, 45, 46, 47] },
          "negative": { "type": "boolean" }
        }
      }
    },
    "terminated": { "type": "boolean" },
    "asdus": { "type": "array", "items": { "$ref": "#/$defs/asdu" } },
    "elapsedMs": { "type": "number", "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "error": { "type": "null" } } },
      "else": { "properties": { "error": { "type": "object" } } } }
  ],
  "$defs": {
    "asdu": {
      "type": "object",
      "required": ["type", "typeId", "cot", "negative", "test", "originator", "commonAddress", "sequence", "count",
                   "objects"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "typeId": { "type": "integer", "minimum": 0, "maximum": 255 },
        "cot": { "type": "integer", "minimum": 0, "maximum": 63 },
        "negative": { "type": "boolean" },
        "test": { "type": "boolean" },
        "originator": { "type": "integer", "minimum": 0, "maximum": 255 },
        "commonAddress": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "sequence": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0, "maximum": 127 },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ioa"],
            "properties": {
              "ioa": { "type": "integer", "minimum": 0, "maximum": 16777215 },
              "value": { "type": ["boolean", "number"] },
              "normalized": { "type": "number" },
              "quality": { "type": "array", "items": { "enum": ["OV", "BL", "SB", "NT", "IV", "CY", "CA"] } },
              "transient": { "type": "boolean" },
              "sequence": { "type": "integer" },
              "select": { "type": "boolean" },
              "qualifier": { "type": "integer" },
              "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
              "timeInvalid": { "type": "boolean" },
              "qoi": { "type": "integer" },
              "qcc": { "type": "integer" },
              "counter": { "type": "integer" },
              "coi": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
